# Ambiente para rodar fora do Docker (pnpm dev). Copie para .env e preencha.
#   cp .env.example .env

NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Postgres local (o servico "db" do docker compose expoe a porta 5432)
POSTGRES_URL=postgresql://admin:admin123@localhost:5432/prompt_manager

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq (opcional: cada usuario tambem pode salvar a propria chave em Settings)
GROQ_API_KEY=

# Ollama local (opcional)
OLLAMA_ENDPOINT=http://localhost:11434
