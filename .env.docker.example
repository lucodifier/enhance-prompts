# Ambiente do container (docker compose). Copie para .env.docker e preencha.
#   cp .env.docker.example .env.docker

# Banco: o host "db" e o servico Postgres do docker-compose.yml
DATABASE_URL=postgresql://admin:admin123@db:5432/prompt_manager
POSTGRES_URL=postgresql://admin:admin123@db:5432/prompt_manager

# URL publica do app. Precisa bater com o redirect URI cadastrado no Google:
#   http://localhost:8080/api/auth/callback/google
NEXTAUTH_URL=http://localhost:8080
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq (opcional: cada usuario tambem pode salvar a propria chave em Settings)
GROQ_API_KEY=

# Ollama rodando na maquina host (opcional)
OLLAMA_ENDPOINT=http://host.docker.internal:11434
