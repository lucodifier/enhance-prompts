# Ignore development dependencies and files
node_modules
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Next.js build outputs
.next
out

# Ignore environment files and local credentials (injected at runtime by docker-compose)
.env*
googleKeys

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore Git
.git
.gitignore

# Ignore IDE
.vscode
.idea

# Ignore Docker files
Dockerfile
.dockerignore
docker-compose.yml

# Ignore temporary files
tmp
temp